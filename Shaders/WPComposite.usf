/**
 * @brief Implements the final wormhole composite pixel shader executed by the
 *        SceneViewExtension.
 *
 * The shader evaluates proxy intersections and SceneDepth visibility, then
 * selects the original SceneColor, the local portal cubemap, or the linked
 * portal cubemap based on the ray refraction result.
 */

#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"
#include "WPRayCommon.ush"

SCREEN_PASS_TEXTURE_VIEWPORT(Input)
SCREEN_PASS_TEXTURE_VIEWPORT(Base)
SCREEN_PASS_TEXTURE_VIEWPORT(Output)

Texture2D InputTexture;
SamplerState InputSampler;
Texture2D BaseSceneColorTexture;
SamplerState BaseSceneColorSampler;
Texture2D SceneDepthTexture;
SamplerState SceneDepthSampler;
Texture3D RayLUTTexture;
SamplerState RayLUTSampler;
float RayLUTZ;
float RayLUTEnabled;
TextureCube LocalCubeTexture;
SamplerState LocalCubeSampler;
TextureCube LinkedCubeTexture;
SamplerState LinkedCubeSampler;

float3 PortalCenterTranslated;
float PortalRadiusCm;
float ThroatLengthCm;
float ProxyRadiusCm;
float MetricOuterRadiusCm;
float DepthBiasCm;
int FilterDebugMode;
float3 SelfX;
float3 SelfY;
float3 SelfZ;
float3 LinkedX;
float3 LinkedY;
float3 LinkedZ;

bool WPSelectSphereHit(
    float3 RayOrigin,
    float3 RayDirection,
    float3 SphereCenter,
    float SphereRadius,
    out float SelectedT,
    out bool bCameraInside,
    out float2 HitDistances)
{
    const float3 OriginToCenter = RayOrigin - SphereCenter;
    const float RadiusSquared = SphereRadius * SphereRadius;
    const float OriginDistanceSquared = dot(OriginToCenter, OriginToCenter);
    bCameraInside = OriginDistanceSquared < RadiusSquared;

    const float ProjectedOrigin = dot(OriginToCenter, RayDirection);
    const float Discriminant = ProjectedOrigin * ProjectedOrigin
        - (OriginDistanceSquared - RadiusSquared);
    if (Discriminant < 0.0f)
    {
        SelectedT = 0.0f;
        HitDistances = 0.0f;
        return false;
    }

    const float Root = sqrt(max(Discriminant, 0.0f));
    HitDistances = float2(-ProjectedOrigin - Root, -ProjectedOrigin + Root);
    SelectedT = bCameraInside ? HitDistances.y : HitDistances.x;
    return SelectedT > 1.0e-4f;
}

float3 WPPrepareCubeDirection(float3 Direction)
{
    return WPSafeNormalize(Direction, float3(0.0f, 0.0f, 1.0f));
}

float3 WPConvertCubeToMainPreExposure(float3 CubeLinearRGB)
{
    return CubeLinearRGB * ResolvedView.PreExposure;
}

float3 WPSampleLocalCubeGrad(
    float3 Direction,
    float3 DirectionDx,
    float3 DirectionDy,
    float PhaseGradientScale)
{
    const float3 SafeDirection = WPPrepareCubeDirection(Direction);
    const float ConservativeScale = clamp(PhaseGradientScale, 1.0f, 65536.0f);
    const float3 CubeLinearRGB = TextureCubeSampleGrad(
        LocalCubeTexture,
        LocalCubeSampler,
        SafeDirection,
        DirectionDx * ConservativeScale,
        DirectionDy * ConservativeScale).rgb;
    return WPConvertCubeToMainPreExposure(CubeLinearRGB);
}

float3 WPSampleLinkedCubeGrad(
    float3 Direction,
    float3 DirectionDx,
    float3 DirectionDy,
    float PhaseGradientScale)
{
    const float3 SafeDirection = WPPrepareCubeDirection(Direction);
    const float ConservativeScale = clamp(PhaseGradientScale, 1.0f, 65536.0f);
    const float3 CubeLinearRGB = TextureCubeSampleGrad(
        LinkedCubeTexture,
        LinkedCubeSampler,
        SafeDirection,
        DirectionDx * ConservativeScale,
        DirectionDy * ConservativeScale).rgb;
    return WPConvertCubeToMainPreExposure(CubeLinearRGB);
}

/**
 * @brief Stores ray derivatives, directional phase footprint, and C2-filtered
 *        optical branch coverage for one output pixel.
 */
struct FWPRayFootprint
{
    float3 BentDx;
    float3 BentDy;
    float3 LinkedDx;
    float3 LinkedDy;
    float2 PhaseGradient;
    float PhaseFootprint;
    float PhaseSpan;
    float DirectionFootprint;
    float BranchFootprint;
    float BranchTransition;
    float RemoteCoverage;
    float CriticalCoverage;
};

float WPC2Smooth01(float Value)
{
    const float X = saturate(Value);
    return X * X * X * (X * (X * 6.0f - 15.0f) + 10.0f);
}

float WPC2Smoothstep(float Edge0, float Edge1, float Value)
{
    return WPC2Smooth01((Value - Edge0) / max(Edge1 - Edge0, 1.0e-6f));
}

FWPRayFootprint WPApplyRayFootprint(inout FWPRayResult RayResult)
{
    FWPRayFootprint Footprint;

    const float3 RawBentDx = ddx(RayResult.BentDirection);
    const float3 RawBentDy = ddy(RayResult.BentDirection);
    const float3 RawLinkedDx = ddx(RayResult.LinkedDirection);
    const float3 RawLinkedDy = ddy(RayResult.LinkedDirection);

    Footprint.BentDx = all(isfinite(RawBentDx)) ? RawBentDx : 0.0f;
    Footprint.BentDy = all(isfinite(RawBentDy)) ? RawBentDy : 0.0f;
    Footprint.LinkedDx = all(isfinite(RawLinkedDx)) ? RawLinkedDx : 0.0f;
    Footprint.LinkedDy = all(isfinite(RawLinkedDy)) ? RawLinkedDy : 0.0f;

    const float2 RawPhaseDerivative = float2(
        ddx(RayResult.BendAngle),
        ddy(RayResult.BendAngle));
    Footprint.PhaseGradient = all(isfinite(RawPhaseDerivative))
        ? RawPhaseDerivative
        : float2(65536.0f, 0.0f);
    Footprint.PhaseFootprint = max(
        abs(Footprint.PhaseGradient.x),
        abs(Footprint.PhaseGradient.y));
    Footprint.PhaseSpan = abs(Footprint.PhaseGradient.x)
        + abs(Footprint.PhaseGradient.y);
    Footprint.DirectionFootprint = max(
        length(Footprint.BentDx),
        length(Footprint.BentDy));

    const float BranchDistance = RayResult.Impact - RayResult.CriticalImpact;
    const float HardRemoteBranch = (
        RayResult.InsideOutward < 0.5f && BranchDistance < 0.0f) ? 1.0f : 0.0f;
    const float2 RawHardBranchDerivative = float2(
        ddx(HardRemoteBranch),
        ddy(HardRemoteBranch));
    Footprint.BranchTransition = all(isfinite(RawHardBranchDerivative))
        ? saturate(abs(RawHardBranchDerivative.x) + abs(RawHardBranchDerivative.y))
        : 1.0f;

    const float2 RawBranchDerivative = float2(
        ddx(BranchDistance),
        ddy(BranchDistance));
    Footprint.BranchFootprint = all(isfinite(RawBranchDerivative))
        ? abs(RawBranchDerivative.x) + abs(RawBranchDerivative.y)
        : 1.0f;

    const float BranchHalfWidth = max(0.5f * Footprint.BranchFootprint, 1.0e-6f);
    Footprint.RemoteCoverage = (RayResult.InsideOutward < 0.5f)
        ? 1.0f - WPC2Smoothstep(-BranchHalfWidth, BranchHalfWidth, BranchDistance)
        : 0.0f;

    // Critical coverage is evaluated once at the center. Directional samples
    // never add independent black values, so filtering cannot widen the band.
    const float InwardCriticalCoverage = (RayResult.InsideOutward < 0.5f)
        ? 1.0f - WPC2Smoothstep(0.0f, BranchHalfWidth, abs(BranchDistance))
        : 0.0f;
    Footprint.CriticalCoverage = max(
        InwardCriticalCoverage,
        saturate(RayResult.TrappedCritical));

    const float PhaseFilterStart = 0.75f;
    RayResult.PhaseGradientScale = (Footprint.PhaseFootprint > PhaseFilterStart)
        ? clamp(
            Footprint.PhaseFootprint / max(Footprint.DirectionFootprint, 1.0e-4f),
            1.0f,
            65536.0f)
        : 1.0f;

    return Footprint;
}

bool WPNeedsDirectionalFiltering(FWPRayFootprint Footprint)
{
    return Footprint.PhaseFootprint > 0.5f
        || Footprint.DirectionFootprint > 0.25f;
}

FWPRayFootprint WPScaleRayFootprint(FWPRayFootprint Footprint, float Scale)
{
    Footprint.BentDx *= Scale;
    Footprint.BentDy *= Scale;
    Footprint.LinkedDx *= Scale;
    Footprint.LinkedDy *= Scale;
    Footprint.PhaseGradient *= Scale;
    Footprint.PhaseFootprint *= Scale;
    Footprint.PhaseSpan *= Scale;
    Footprint.DirectionFootprint *= Scale;

    return Footprint;
}

/** Stores the local-universe SceneColor projection result and its validity state. */
struct FWPLocalLensResult
{
    float3 Color;
    float ProjectionValid;
    float SubpixelIdentity;
};

/** Resolves the local-universe color using SceneColor reprojection or local cubemap fallback. */
FWPLocalLensResult WPResolveLocalLens(
    FWPRayResult RayResult,
    FWPRayFootprint RayFootprint,
    float2 CurrentViewportUV,
    float3 CurrentSceneColor)
{
    FWPLocalLensResult Result;
    Result.Color = WPSampleLocalCubeGrad(
        RayResult.BentDirection,
        RayFootprint.BentDx,
        RayFootprint.BentDy,
        RayResult.PhaseGradientScale);
    Result.ProjectionValid = 0.0f;
    Result.SubpixelIdentity = 0.0f;

    const float3 ProjectedTranslatedWS = ResolvedView.TranslatedWorldCameraOrigin
        + RayResult.BentDirection * max(MetricOuterRadiusCm, 100.0f);
    const float4 ProjectedClip = mul(
        float4(ProjectedTranslatedWS, 1.0f),
        ResolvedView.TranslatedWorldToClip);
    const float SafeProjectedW = max(abs(ProjectedClip.w), 1.0e-6f);
    const float2 ProjectedScreenPosition = ProjectedClip.xy / SafeProjectedW;

    const float2 ProjectedViewportUVJittered = ScreenPosToViewportUV(ProjectedScreenPosition);
    const float2 ProjectionJitterViewportUV = float2(0.5f, -0.5f) * ResolvedView.TemporalAAJitter.xy;
    const float2 ProjectedViewportUV = ProjectedViewportUVJittered - ProjectionJitterViewportUV;

    const float ProjectionFinite = (
        all(isfinite(ProjectedClip)) && all(isfinite(ProjectedViewportUV))) ? 1.0f : 0.0f;
    const float ProjectionInFront = (ProjectedClip.w > 1.0e-6f) ? 1.0f : 0.0f;
    const float ProjectionInViewport = (
        all(ProjectedViewportUV >= 0.0f)
        && all(ProjectedViewportUV <= 1.0f)) ? 1.0f : 0.0f;
    Result.ProjectionValid = ProjectionFinite
        * ProjectionInFront
        * ProjectionInViewport;

    const float2 SafeProjectedViewportUV = (ProjectionFinite > 0.5f)
        ? saturate(ProjectedViewportUV)
        : 0.5f;

    const float2 ProjectedBaseUV = clamp(
        (SafeProjectedViewportUV * Base_ViewportSize + float2(Base_ViewportMin))
            * Base_ExtentInverse,
        Base_UVViewportBilinearMin,
        Base_UVViewportBilinearMax);
    const float3 ProjectedSceneColor = BaseSceneColorTexture.SampleLevel(
        BaseSceneColorSampler,
        ProjectedBaseUV,
        0.0f).rgb;

    const float2 ViewportPixelSize = max(Base_ViewportSize, 1.0f);
    const float ProjectedPixelDisplacement = length(
        (SafeProjectedViewportUV - CurrentViewportUV) * ViewportPixelSize);
    Result.SubpixelIdentity = (
        Result.ProjectionValid > 0.5f
        && ProjectedPixelDisplacement <= 0.5f) ? 1.0f : 0.0f;

    const float UseProjectedSceneColor = Result.ProjectionValid
        * (1.0f - RayResult.CameraInsideProxy);

    [branch]
    if (UseProjectedSceneColor > 0.5f)
    {
        Result.Color = (Result.SubpixelIdentity > 0.5f)
            ? CurrentSceneColor
            : ProjectedSceneColor;
    }

    return Result;
}

/** Evaluates the final composite color based on the ray branch. */
float3 WPEvaluateCompositeColor(
    FWPRayResult RayResult,
    FWPRayFootprint RayFootprint,
    float2 OutputViewportUV,
    float3 CurrentSceneColor)
{
    const FWPLocalLensResult LocalLens = WPResolveLocalLens(
        RayResult,
        RayFootprint,
        OutputViewportUV,
        CurrentSceneColor);

    const float3 RemoteColor = WPSampleLinkedCubeGrad(
    RayResult.LinkedDirection,
    RayFootprint.LinkedDx,
    RayFootprint.LinkedDy,
    RayResult.PhaseGradientScale);

    const float3 BranchColor = lerp(
        LocalLens.Color,
        RemoteColor,
        RayFootprint.RemoteCoverage);

    return lerp(BranchColor, 0.0f, RayFootprint.CriticalCoverage);
}

float3 WPSampleInputSceneColor(float2 OutputViewportUV)
{
    const float2 InputUV = clamp(
        (OutputViewportUV * Input_ViewportSize + float2(Input_ViewportMin)) * Input_ExtentInverse,
        Input_UVViewportBilinearMin,
        Input_UVViewportBilinearMax);
    return InputTexture.SampleLevel(InputSampler, InputUV, 0.0f).rgb;
}

float3 WPBuildViewRayDirection(float2 GeometryViewportUV)
{
    const float2 ScreenPosition = ViewportUVToScreenPos(GeometryViewportUV);
    return normalize(
        ScreenVectorFromScreenRect(float4(ScreenPosition, 1.0f, 0.0f), ResolvedView));
}

float2 WPGetPhaseSampleExtent(FWPRayFootprint Footprint)
{
    const float GradientLength = length(Footprint.PhaseGradient);
    float2 PhaseAxis = (GradientLength > 1.0e-6f)
        ? Footprint.PhaseGradient / GradientLength
        : float2(1.0f, 0.0f);
    const float PixelEdgeDistance = 0.5f / max(
        max(abs(PhaseAxis.x), abs(PhaseAxis.y)),
        1.0e-4f);
    return PhaseAxis * PixelEdgeDistance;
}

/** Evaluates one directional subpixel sample along the phase gradient. */
float3 WPEvaluateDirectionalSample(
    float2 SampleOffsetPixels,
    float FootprintScale,
    float2 OutputViewportUV,
    float2 GeometryViewportUV,
    float3 CameraOffset,
    FWPRayResult CenterRayResult,
    FWPRayFootprint CenterFootprint,
    float3 CenterCompositeColor)
{
    const float2 UVOffset = SampleOffsetPixels * Output_ViewportSizeInverse;
    const float2 SubpixelOutputUV = saturate(OutputViewportUV + UVOffset);
    const float2 SubpixelGeometryUV = GeometryViewportUV + UVOffset;
    const float3 SubpixelRayDirection = WPBuildViewRayDirection(SubpixelGeometryUV);

    FWPRayResult SubpixelRayResult = WPEvaluateRay(
        RayLUTTexture,
        RayLUTSampler,
        RayLUTZ,
        RayLUTEnabled,
        SubpixelRayDirection,
        CameraOffset,
        PortalRadiusCm,
        ThroatLengthCm,
        ProxyRadiusCm,
        SelfX,
        SelfY,
        SelfZ,
        LinkedX,
        LinkedY,
        LinkedZ,
        ResolvedView.ViewRight,
        ResolvedView.ViewUp);

    if (SubpixelRayResult.Valid < 0.5f)
    {
        return CenterCompositeColor;
    }

    SubpixelRayResult.PhaseGradientScale = CenterRayResult.PhaseGradientScale;
    const FWPRayFootprint SubpixelFootprint = WPScaleRayFootprint(
        CenterFootprint,
        FootprintScale);
    const float3 SubpixelSceneColor = WPSampleInputSceneColor(SubpixelOutputUV);

    return WPEvaluateCompositeColor(
        SubpixelRayResult,
        SubpixelFootprint,
        SubpixelOutputUV,
        SubpixelSceneColor);
}

float3 WPDirectionalSupersample4(
    float2 OutputViewportUV,
    float2 GeometryViewportUV,
    float3 CameraOffset,
    FWPRayResult CenterRayResult,
    FWPRayFootprint CenterFootprint,
    float3 CenterCompositeColor)
{
    const float2 Extent = WPGetPhaseSampleExtent(CenterFootprint);
    const float3 Sample0 = WPEvaluateDirectionalSample(
        Extent * -0.75f, 0.25f, OutputViewportUV, GeometryViewportUV,
        CameraOffset, CenterRayResult, CenterFootprint, CenterCompositeColor);
    const float3 Sample1 = WPEvaluateDirectionalSample(
        Extent * -0.25f, 0.25f, OutputViewportUV, GeometryViewportUV,
        CameraOffset, CenterRayResult, CenterFootprint, CenterCompositeColor);
    const float3 Sample2 = WPEvaluateDirectionalSample(
        Extent * 0.25f, 0.25f, OutputViewportUV, GeometryViewportUV,
        CameraOffset, CenterRayResult, CenterFootprint, CenterCompositeColor);
    const float3 Sample3 = WPEvaluateDirectionalSample(
        Extent * 0.75f, 0.25f, OutputViewportUV, GeometryViewportUV,
        CameraOffset, CenterRayResult, CenterFootprint, CenterCompositeColor);
    return (Sample0 + Sample1 + Sample2 + Sample3) * 0.25f;
}

float3 WPDirectionalSupersample8(
    float2 OutputViewportUV,
    float2 GeometryViewportUV,
    float3 CameraOffset,
    FWPRayResult CenterRayResult,
    FWPRayFootprint CenterFootprint,
    float3 CenterCompositeColor)
{
    const float2 Extent = WPGetPhaseSampleExtent(CenterFootprint);
    float3 Sum = 0.0f;

    [unroll]
    for (int SampleIndex = 0; SampleIndex < 8; ++SampleIndex)
    {
        const float SamplePosition = ((float)SampleIndex + 0.5f) * 0.25f - 1.0f;
        Sum += WPEvaluateDirectionalSample(
            Extent * SamplePosition,
            0.125f,
            OutputViewportUV,
            GeometryViewportUV,
            CameraOffset,
            CenterRayResult,
            CenterFootprint,
            CenterCompositeColor);
    }

    return Sum * 0.125f;
}

void MainPS(float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
{
    ResolvedView = ResolveView();

    const float2 OutputViewportUV =
        (SvPosition.xy - float2(Output_ViewportMin)) * Output_ViewportSizeInverse;
    const float2 GeometryViewportUV = OutputViewportUV
        + float2(0.5f, -0.5f) * ResolvedView.TemporalAAJitter.xy;
    const float2 InputUV = clamp(
        (OutputViewportUV * Input_ViewportSize + float2(Input_ViewportMin)) * Input_ExtentInverse,
        Input_UVViewportBilinearMin,
        Input_UVViewportBilinearMax);
    const float4 SceneColor = InputTexture.SampleLevel(InputSampler, InputUV, 0.0f);
    OutColor = SceneColor;
    float PortalVisibility = 1.0f;

    const float2 ScreenPosition = ViewportUVToScreenPos(GeometryViewportUV);
    const float3 RayOrigin = ResolvedView.TranslatedWorldCameraOrigin;
    const float3 RayDirection = normalize(
        ScreenVectorFromScreenRect(float4(ScreenPosition, 1.0f, 0.0f), ResolvedView));

    float OuterHitT = 0.0f;
    bool bCameraInsideOuter = false;
    float2 OuterHitDistances = 0.0f;
    if (!WPSelectSphereHit(
        RayOrigin,
        RayDirection,
        PortalCenterTranslated,
        ProxyRadiusCm,
        OuterHitT,
        bCameraInsideOuter,
        OuterHitDistances))
    {
        return;
    }

    const float3 CameraOffset = RayOrigin - PortalCenterTranslated;
    const float CoverageCarrierRadius = ProxyRadiusCm * 1.05f;
    const bool bUseFarCoverageRoot = dot(CameraOffset, CameraOffset)
        < CoverageCarrierRadius * CoverageCarrierRadius;
    const float CoverageHitT = bUseFarCoverageRoot ? OuterHitDistances.y : OuterHitDistances.x;
    if (CoverageHitT <= 1.0e-4f)
    {
        return;
    }

    const float3 CoverageHitTranslated = RayOrigin + RayDirection * CoverageHitT;
    const float4 CoverageHitClip = mul(
        float4(CoverageHitTranslated, 1.0f),
        ResolvedView.TranslatedWorldToClip);
    if (CoverageHitClip.w <= 0.0f || CoverageHitClip.z > CoverageHitClip.w)
    {
        return;
    }

    if (!bCameraInsideOuter)
    {
        const float2 SceneDepthUV = clamp(
            ViewportUVToBufferUV(GeometryViewportUV),
            ResolvedView.BufferBilinearUVMinMax.xy,
            ResolvedView.BufferBilinearUVMinMax.zw);
        const float DeviceZ = SceneDepthTexture.SampleLevel(
            SceneDepthSampler,
            SceneDepthUV,
            0.0f).r;
        const float SceneDepthCm = ConvertFromDeviceZ(DeviceZ);
        const float3 OuterHitTranslated = RayOrigin + RayDirection * OuterHitT;
        const float4 OuterHitClip = mul(
            float4(OuterHitTranslated, 1.0f),
            ResolvedView.TranslatedWorldToClip);

        const float DepthDeltaCm = SceneDepthCm + DepthBiasCm - OuterHitClip.w;
        const float DepthDeltaDx = abs(ddx(DepthDeltaCm));
        const float DepthDeltaDy = abs(ddy(DepthDeltaCm));
        const float AutoFeatherCm = DepthDeltaDx + DepthDeltaDy;
        const float DepthFeatherCm = clamp(max(AutoFeatherCm, 2.0f), 2.0f, 50.0f);
        const float DepthVisibility = smoothstep(
            -DepthFeatherCm,
            DepthFeatherCm,
            DepthDeltaCm);

        if (DepthVisibility <= 0.001f)
        {
            return;
        }

        PortalVisibility *= DepthVisibility;
    }

    FWPRayResult RayResult = WPEvaluateRay(
        RayLUTTexture,
        RayLUTSampler,
        RayLUTZ,
        RayLUTEnabled,
        RayDirection,
        CameraOffset,
        PortalRadiusCm,
        ThroatLengthCm,
        ProxyRadiusCm,
        SelfX,
        SelfY,
        SelfZ,
        LinkedX,
        LinkedY,
        LinkedZ,
        ResolvedView.ViewRight,
        ResolvedView.ViewUp);
    if (RayResult.Valid < 0.5f)
    {
        return;
    }

    const FWPRayFootprint RayFootprint = WPApplyRayFootprint(RayResult);
    float3 CompositeColor = WPEvaluateCompositeColor(
        RayResult,
        RayFootprint,
        OutputViewportUV,
        SceneColor.rgb);

    const float Pi = 3.14159265358979323846f;

    [branch]
    if (RayFootprint.BranchTransition < 0.5f && RayFootprint.PhaseSpan >= Pi)
    {
        CompositeColor = WPDirectionalSupersample8(
            OutputViewportUV,
            GeometryViewportUV,
            CameraOffset,
            RayResult,
            RayFootprint,
            CompositeColor);
    }
    else if (
        RayFootprint.BranchTransition < 0.5f
        && WPNeedsDirectionalFiltering(RayFootprint))
    {
        CompositeColor = WPDirectionalSupersample4(
            OutputViewportUV,
            GeometryViewportUV,
            CameraOffset,
            RayResult,
            RayFootprint,
            CompositeColor);
    }

    [branch]
    if (FilterDebugMode > 0)
    {
        float3 FilterDebugColor = 0.0f;
        float FilterDebugCoverage = 0.0f;
        const float HasCriticalCoverage = step(1.0e-3f, RayFootprint.CriticalCoverage);
        const float HasBranchCoverage = max(
            RayFootprint.BranchTransition,
            step(1.0e-3f, RayFootprint.RemoteCoverage)
                * step(RayFootprint.RemoteCoverage, 1.0f - 1.0e-3f));

        if (HasCriticalCoverage > 0.5f)
        {
            FilterDebugColor = float3(1.0f, 0.0f, 0.0f);
            FilterDebugCoverage = 1.0f;
        }
        else if (HasBranchCoverage > 0.5f)
        {
            FilterDebugColor = float3(0.0f, 1.0f, 1.0f);
            FilterDebugCoverage = 1.0f;
        }
        else if (RayFootprint.PhaseSpan >= Pi)
        {
            FilterDebugColor = float3(1.0f, 0.25f, 0.0f);
            FilterDebugCoverage = 1.0f;
        }
        else if (WPNeedsDirectionalFiltering(RayFootprint))
        {
            FilterDebugColor = float3(1.0f, 1.0f, 0.0f);
            FilterDebugCoverage = 1.0f;
        }

        CompositeColor = lerp(
            CompositeColor,
            FilterDebugColor,
            FilterDebugCoverage);
    }

    OutColor.rgb = lerp(SceneColor.rgb, CompositeColor, PortalVisibility);
}
